# systemd user service: `systemctl --user enable --now scrim`
# Starts Scrim with the graphical session (works with Wayland compositors and X11
# sessions that activate graphical-session.target, e.g. KDE, Sway with uwsm, Hyprland).
[Unit]
Description=Scrim animated wallpaper effects
PartOf=graphical-session.target
After=graphical-session.target

[Service]
ExecStart=@BINDIR@/scrim
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
