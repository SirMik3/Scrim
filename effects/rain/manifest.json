{
  "format": 1,
  "id": "rain",
  "name": "Rain",
  "version": "0.1.0",
  "license": "MIT",
  "passes": [
    { "shader": "background.frag", "scale": 0.5 },
    { "shader": "streaks.frag",    "scale": 0.5 },
    { "shader": "drops.frag" }
  ],
  "params": [
    { "id": "darken",     "label": "Darken",           "type": "float", "min": 0,    "max": 1,   "default": 0.35 },
    { "id": "fog",        "label": "Fog",              "type": "float", "min": 0,    "max": 1,   "default": 0.6 },
    { "id": "tint",       "label": "Cool tint",        "type": "float", "min": 0,    "max": 1,   "default": 0.35 },
    { "id": "rain",       "label": "Rain density",     "type": "float", "min": 0,    "max": 1,   "default": 0.55 },
    { "id": "rainSpeed",  "label": "Rain speed",       "type": "float", "min": 0.2,  "max": 2,   "default": 1.0 },
    { "id": "wind",       "label": "Wind",             "type": "float", "min": -0.5, "max": 0.5, "default": 0.08 },
    { "id": "streakGlow", "label": "Streak brightness","type": "float", "min": 0,    "max": 1,   "default": 0.35 },
    { "id": "drops",      "label": "Drops on glass",   "type": "float", "min": 0,    "max": 1,   "default": 0.6 },
    { "id": "sliding",    "label": "Sliding drops",    "type": "float", "min": 0,    "max": 1,   "default": 0.45 },
    { "id": "dropSize",   "label": "Drop size",        "type": "float", "min": 0.5,  "max": 1.6, "default": 1.0 },
    { "id": "refraction", "label": "Refraction",       "type": "float", "min": 0,    "max": 1,   "default": 0.6 },
    { "id": "clarity",    "label": "Clarity in drops", "type": "float", "min": 0,    "max": 1,   "default": 0.75 }
  ]
}
