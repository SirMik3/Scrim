{
  "format": 1,
  "id": "snow",
  "name": "Snow",
  "version": "0.1.0",
  "license": "MIT",
  "passes": [
    { "shader": "background.frag", "scale": 0.5 },
    { "shader": "flakes.frag" }
  ],
  "params": [
    { "id": "amount", "label": "Snowfall",     "type": "float", "min": 0,    "max": 1,   "default": 0.6 },
    { "id": "speed",  "label": "Speed",        "type": "float", "min": 0.2,  "max": 2,   "default": 1.0 },
    { "id": "wind",   "label": "Wind",         "type": "float", "min": -1,   "max": 1,   "default": 0.15 },
    { "id": "size",   "label": "Flake size",   "type": "float", "min": 0.5,  "max": 2,   "default": 1.0 },
    { "id": "blur",   "label": "Background blur", "type": "float", "min": 0, "max": 1,   "default": 0.3 },
    { "id": "frost",  "label": "Frost",        "type": "float", "min": 0,    "max": 1,   "default": 0.35 },
    { "id": "darken", "label": "Darken",       "type": "float", "min": 0,    "max": 1,   "default": 0.2 }
  ]
